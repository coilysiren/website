---
layout: layouts/base.njk
permalink: about/index.html
title: About | Kai Ase Siren
description: Kai Ase Siren is a platform engineer building governed infrastructure for agentic systems.
canonical: /about/
robots: follow, index
personSchema: true
---
{% macro iconListItem(icon, label) %}
  <li><span class="my-life-slide__list-icon" aria-hidden="true">{{ icon }}</span>{{ label }}</li>
{% endmacro %}
{% macro photo(src, alt, className) %}
  {%- set size = src | imageSize -%}
  <img loading="lazy" decoding="async"
    {%- if className %} class="{{ className }}"{% endif %}
    src="{{ src }}" width="{{ size.width }}" height="{{ size.height }}"
    alt="{{ alt }}">
{% endmacro %}
{% macro clip(src, alt, className) %}
  {#- Was an animated GIF. Same silent loop, a fraction of the bytes, and
      demo-reel.js starts it on scroll so it costs nothing until seen. -#}
  <video class="{{ className }}" src="{{ src }}" poster="{{ src | replace('.mp4', '-poster.jpg') }}"
    width="960" height="540" muted loop playsinline preload="none"
    data-play-in-view aria-label="{{ alt }}"></video>
{% endmacro %}
{% macro favoriteSlide(group) %}
  <article id="{{ group.id }}" class="my-life-slide my-life-slide--favorites {{ group.className }}">
    <div class="my-life-slide__copy">
      <h2><a href="#{{ group.id }}">{{ group.title }}</a></h2>
      <ul class="my-life-slide__list">
        {% for favorite in group.favorites %}
          {{ iconListItem(favorite.icon or group.icon or "•", favorite.label) }}
        {% endfor %}
      </ul>
    </div>
    <div class="my-life-favorite-grid">
      {% for favorite in group.favorites %}
        {{ photo(favorite.src, favorite.alt) }}
      {% endfor %}
    </div>
  </article>
{% endmacro %}
<section class="my-life">
  <header id="about" class="my-life-slide my-life-slide--intro">
    {%- set portrait = "/my-life/16-car-headphones-sunglasses.jpg" | imageSize %}
    <img
      class="my-life-intro__portrait"
      src="/my-life/16-car-headphones-sunglasses.jpg"
      width="{{ portrait.width }}" height="{{ portrait.height }}"
      alt="Kai wearing sunglasses and headphones in a car"
    >
    <div class="my-life-slide__copy">
      <h1><a href="#about">Hi, I'm Kai</a></h1>
      <p>
        I live in the East Bay and spend time on games, gardening,
        fabrication, and side projects. This is a visual tour of the things
        that make up my life.
      </p>
    </div>
  </header>
  {{ favoriteSlide(about.animals) }}
  <article id="fabrication" class="my-life-slide my-life-slide--home">
    <div class="my-life-home-images">
      {{ photo("/my-life/12-wall-under-construction.jpg", "A home interior with a newly framed wall", "my-life-home-images__primary") }}
      {{ photo("/my-life/07-adu-floor-plan.png", "An ADU floor plan", "my-life-home-images__plan") }}
      {{ photo("/my-life/15-red-garden-bed.jpg", "A newly planted red raised garden bed", "my-life-home-images__garden") }}
      {{ photo("/my-life/18-garden-bed-construction.jpg", "Raised garden beds under construction", "my-life-home-images__build") }}
    </div>
    <div class="my-life-slide__copy">
      <h2><a href="#fabrication">Fabrication</a></h2>
      <ul class="my-life-slide__list">
        {{ iconListItem("🛠️", "Walls") }}
        {{ iconListItem("🛠️", "Gardens") }}
        {{ iconListItem("🛠️", "ADUs") }}
      </ul>
    </div>
  </article>
  <article id="tech" class="my-life-slide my-life-slide--technology">
    <div class="my-life-slide__copy">
      <h2><a href="#tech">Tech</a></h2>
      <ul class="my-life-slide__list">
        {{ iconListItem("💻", "Towers") }}
        {{ iconListItem("💻", "Monitors") }}
      </ul>
    </div>
    <div class="my-life-project-grid my-life-technology-grid">
      {{ photo("/my-life/17-tower-interior.jpg", "The blue and purple lit interior of a desktop computer tower", "my-life-technology-grid__tower") }}
      {{ photo("/my-life/14-two-monitor-desktop.jpg", "A colorful two-monitor desk setup", "my-life-technology-grid__screens") }}
      {{ photo("/my-life/08-motherboard-and-gpu.jpg", "A motherboard and graphics card lit by purple LEDs", "my-life-technology-grid__hardware") }}
    </div>
  </article>
  {{ favoriteSlide(about.books) }}
  {{ favoriteSlide(about.games) }}
  <article id="gaming" class="my-life-slide my-life-slide--gaming">
    <div class="my-life-slide__copy">
      <h2><a href="#gaming">Gaming</a></h2>
      <ul class="my-life-slide__list">
        {{ iconListItem("🎮", "Factories") }}
        {{ iconListItem("🎮", "Galaxies") }}
        {{ iconListItem("🎮", "Economies") }}
      </ul>
    </div>
    <div class="my-life-project-grid my-life-gaming-grid">
      {{ clip("/my-life/project-factory-game.mp4", "An animated factory game simulation", "my-life-gaming-grid__factory") }}
      {{ clip("/my-life/project-galaxy-gen.mp4", "An animated procedural galaxy generator", "my-life-gaming-grid__galaxy") }}
      {{ photo("/my-life/05-eco-app-dashboard.png", "A dark green Eco application dashboard", "my-life-gaming-grid__eco") }}
    </div>
  </article>
  {{ favoriteSlide(about.shows) }}
  {{ favoriteSlide(about.anime) }}
  {{ favoriteSlide(about.movies) }}
  {% include "components/closer.njk" %}
  <script src="/demo-reel.js" defer></script>
</section>
