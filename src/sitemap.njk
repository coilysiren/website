---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
{%- set locations = [] -%}
{%- for item in collections.all -%}
  {#- The crawlable set is whatever each page declares about itself, so a
      retired route stays out and a newly indexed one appears without an edit. -#}
  {%- if item.data.canonical and item.data.robots and ("noindex" not in item.data.robots) -%}
    {%- set locations = (locations.push(site.url + item.data.canonical), locations) -%}
  {%- endif -%}
{%- endfor -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for location in locations | sort %}
  <url>
    <loc>{{ location }}</loc>
  </url>
{%- endfor %}
</urlset>
