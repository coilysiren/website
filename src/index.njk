---
layout: layouts/base.njk
permalink: index.html
description: Kai Siren builds governed agent systems, developer infrastructure, and the platform layer underneath.
canonical: /
robots: follow, index
---
<div class="portfolio-home">
  <header class="portfolio-hero">
    <div class="portfolio-hero__copy">
      <h1>I build agentic engineering platforms</h1>
      <p class="portfolio-hero__lede portfolio-hero__tagline">
        <span><span aria-hidden="true">🌑</span> lights out,</span>
        <span><span aria-hidden="true">🟢</span> flight deck green,</span>
        <span><span aria-hidden="true">🛡️</span> agents warded for an 8h+ run</span>
      </p>
    </div>
    <aside class="portfolio-hero__portrait">
      <div class="portrait-frame">
        <img src="/images/headshot.jpg" alt="Kai Siren">
      </div>
    </aside>
  </header>
  <section id="products" class="product-showcase">
    <div class="product-showcase__inner">
      <div class="section-heading">
        <h2>Shipped products</h2>
      </div>
      <ul class="product-showcase__grid">
        {% for product in showcase %}
          <li
            class="product-tile{% if not product.banner %} product-tile--wide{% endif %}"
            data-product="{{ product.slug }}"
          >
            {% if product.url %}
              <a class="product-tile__surface" href="{{ product.url }}">
            {% else %}
              <div class="product-tile__surface product-tile__surface--private">
            {% endif %}
              {% if product.banner %}
                <img
                  class="product-tile__banner"
                  src="{{ product.banner }}"
                  srcset="{{ product.banner }} 1280w, {{ product.banner2x }} 2560w"
                  sizes="(min-width: 900px) 45vw, 92vw"
                  width="1280"
                  height="640"
                  alt="{{ product.alt }}"
                  loading="lazy"
                  decoding="async"
                >
              {% else %}
                <span class="product-tile__plate">
                  <span class="product-tile__stage">{{ product.stage }}</span>
                  <span class="product-tile__wordmark">{{ product.wordmark }}</span>
                  <span class="product-tile__claim">{{ product.claim }}</span>
                </span>
              {% endif %}
              <p class="product-tile__proof">{{ product.proof }}</p>
              {% if product.privateRepo %}
                <small class="product-tile__meta">Private repository</small>
              {% else %}
                <small class="product-tile__meta">Source ↗</small>
              {% endif %}
            {% if product.url %}</a>{% else %}</div>{% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
</div>
