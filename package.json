{
  "name": "coilysiren-dot-me",
  "description": "a website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Kai Ase Siren <coilysiren@gmail.com>",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@eslint/js": "^10.0.1",
    "@fontsource/roboto": "^5.3.0",
    "@types/node": "^24.0.0",
    "axe-core": "4.13.0",
    "cypress": "^15.19.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prismjs": "^1.30.0",
    "sass": "^1.101.7",
    "start-server-and-test": "^3.0.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13.0 <27",
    "pnpm": ">=11.17.0 <12"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm run clean && eleventy",
    "clean": "node scripts/clean-output.mjs",
    "dev": "pnpm run clean && eleventy --serve --port=8000",
    "serve": "eleventy --serve --port=8000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit --project cypress/tsconfig.json",
    "test": "pnpm run test:quick",
    "test:quick": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test:unit",
    "test:unit": "vitest run",
    "test:e2e:local": "start-server-and-test \"pnpm run serve\" http://127.0.0.1:8000 \"pnpm exec cypress open --e2e\"",
    "test:e2e:ci": "start-server-and-test \"pnpm run serve\" http://127.0.0.1:8000 \"pnpm exec cypress run\""
  },
  "prettier": {
    "endOfLine": "auto",
    "semi": false,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}
