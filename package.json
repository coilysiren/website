{
  "name": "coilysiren-dot-me",
  "description": "a website",
  "version": "1.0.0",
  "private": true,
  "author": "Kai Siren <coilysiren@gmail.com>",
  "dependencies": {
    "@atproto/api": "^0.20.33",
    "gatsby": "^5.16.1",
    "gatsby-plugin-feed": "^5.16.0",
    "gatsby-plugin-sass": "^6.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-remark-copy-linked-files": "^6.16.0",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-prismjs": "^7.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "js-yaml": "^5.2.2",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.101.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/roboto": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/parse-link-header": "^2.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.65.0",
    "cypress": "^15.19.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-unicorn": "^72.0.0",
    "gatsby-cli": "^5.16.0",
    "globals": "^17.7.0",
    "p-limit": "^7.3.1",
    "parse-link-header": "^2.0.0",
    "prettier": "^3.9.6",
    "satori": "^0.29.0",
    "start-server-and-test": "^3.0.11",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13.0 <27",
    "pnpm": ">=11.17.0 <12"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm run render-og && gatsby clean && gatsby build",
    "clean": "gatsby clean",
    "render-og": "tsx scripts/render-og-images.tsx",
    "dev": "gatsby clean && gatsby develop",
    "serve": "gatsby serve --port 8000 --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit --project cypress/tsconfig.json",
    "test": "pnpm run test:quick",
    "test:quick": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit",
    "test:unit": "vitest run",
    "test:e2e:local": "start-server-and-test \"pnpm run serve\" http://127.0.0.1:8000 \"pnpm exec cypress open --e2e\"",
    "test:e2e:ci": "start-server-and-test \"pnpm run serve\" http://127.0.0.1:8000 \"pnpm exec cypress run\"",
    "fetch-pulse-data": "tsx scripts/fetch-pulse-data.ts",
    "youtube-auth": "tsx scripts/youtube-auth.ts"
  },
  "prettier": {
    "endOfLine": "auto",
    "semi": false,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}
